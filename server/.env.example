# Sunucu
PORT=3035
HOST=127.0.0.1
DB_PATH=./data/mukansa.db

# Reverse proxy (nginx) arkasında istemci IP'si için
TRUST_PROXY=1

# Bildirim zamanlayıcı (dakikada bir kontrol; 0 = kapalı)
SCHEDULER_INTERVAL_MIN=15
# 1 ise Expo Push API'ye gitmez, sadece loglar
PUSH_DRY_RUN=0

# Sadece expo web ile test için (virgülle ayrılmış origin'ler); prod'da boş bırak
CORS_ORIGINS=

# Yönetim paneli (0 = kapalı). Panel API'den ayrı porttadır; nginx ayrı alan adıyla buna proxy eder.
ADMIN_PORT=3036
# HTTPS arkasında 1 (çerezler Secure olur)
ADMIN_SECURE_COOKIES=0
